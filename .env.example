# 6-digit PIN the instructor uses to log into the dashboard (required)
INSTRUCTOR_PIN=123456

# Secret used to sign JWTs — use a long random string in production (required)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Port the server listens on (default: 80)
PORT=80

# Path to the SQLite database file
# On Railway/Render: point this at your persistent volume, e.g. /data/chat.db
DB_PATH=./data/chat.db

# CSV file of enrolled students (required). Needs a header row with a column named
# student_id; other columns are ignored. The file is re-read on every student login,
# so edits take effect without a restart.
# On Railway/Render: keep it on the persistent volume, e.g. /data/roster.csv
ROSTER_PATH=./data/roster.csv

# Number of proxies between students and this server (default: 0)
# Sets req.ip, which is logged with each message and used to rate-limit requests
# that carry no student token (/join, instructor login).
# 0 when running locally. On Railway, set to 1 after checking the logged IP
# against a real request: too low logs the proxy's address, too high lets a
# client choose its own logged IP.
TRUST_PROXY_HOPS=0
